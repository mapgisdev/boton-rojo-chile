[Unit]
Description=Botón Rojo — cálculo del índice y agregación comunal
PartOf=boton-rojo.target
Requires=boton-rojo-descarga.service
After=boton-rojo-descarga.service

[Service]
Type=oneshot
User=botonrojo
WorkingDirectory=/opt/boton-rojo
Environment=PYTHONUNBUFFERED=1
# Dejar un núcleo libre para que los servicios de publicación sigan respondiendo
# mientras corre el cálculo.
CPUQuota=700%
MemoryMax=24G
ExecStart=/opt/boton-rojo/.venv/bin/python -m botonrojo.calculo \
    --grib /datos/gfs --salida /datos/productos \
    --dem /datos/estaticos/dem.tif \
    --worldcover /datos/estaticos/worldcover.tif \
    --comunas /datos/estaticos/comunas.gpkg
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/datos
